generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  studentId String?   @unique
  role      String    @default("STUDENT")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]
  dashboard UserDashboard?
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model UserDashboard {
  id                   String                 @id @default(cuid())
  userId               String                 @unique
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  points               Int                    @default(0)
  codingStreak         Int                    @default(0)
  weeklyProgress       Int                    @default(0)
  completedAssessments Int                    @default(0)
  codingScore          Int                    @default(0)
  courseProgress       UserCourseProgress[]
  assessmentProgress   UserAssessmentProgress[]
  activities           UserActivity[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
}

model UserCourseProgress {
  id          String         @id @default(cuid())
  dashboardId String
  dashboard   UserDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  courseId    String
  title       String
  progress    Int            @default(0)
  updatedAt   DateTime       @updatedAt

  @@unique([dashboardId, courseId])
}

model UserActivity {
  id          String         @id @default(cuid())
  dashboardId String
  dashboard   UserDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  description String
  createdAt   DateTime       @default(now())

  @@index([dashboardId, createdAt])
}

model UserAssessmentProgress {
  id           String        @id @default(cuid())
  dashboardId  String
  dashboard    UserDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  status       String        @default("Not started")
  score        Int?
  completedAt  DateTime?
  updatedAt    DateTime      @updatedAt

  @@unique([dashboardId, assessmentId])
}

model Course {
  id               String   @id
  title            String
  instructor       String?
  category         String
  progress         Int      @default(0)
  lessonsCompleted Int      @default(0)
  totalLessons     Int      @default(0)
  status           String   @default("Continue")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Assessment {
  id          String   @id
  title       String
  category    String
  count       Int      @default(0)
  description String?
  status      String   @default("Open")
  userProgress UserAssessmentProgress[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LeaderboardEntry {
  id                   String   @id
  name                 String
  department           String
  points               Int      @default(0)
  level                Int      @default(1)
  completedAssessments Int      @default(0)
  codingScore          Int      @default(0)
  weeklyProgress       Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model BlogPost {
  id          String   @id
  title       String
  category    String
  author      String
  publishedAt String
  readTime    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Training {
  id        String   @id
  title     String
  trainer   String
  date      String
  duration  String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
